// MDM PROJECT — unified schema
// Implements the platform core (contacts, conversations, tickets, audit, config)
// plus the Onboarding Agent (onboarding_task) and Account Manager (am_task) modules.
// SQLite for development; switch provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // dev default in .env: file:./dev.db
}

// ───────────────────────── Users & roles ─────────────────────────
// role: OA_AGENT | SHIFT_LEAD | MANAGER | ADMIN | ACCOUNT_MANAGER | READ_ONLY
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           String
  markets        String    @default("[]") // JSON array of country codes (skills / AM market)
  businessNumber String? // AM: the WhatsApp business number the book runs on
  shiftMinutes   Int       @default(480)
  active         Boolean   @default(true)
  onCall         Boolean   @default(false) // Yeastar presence; manual toggle until PBX wired
  extension      String?   @unique // Yeastar extension, maps PBX call events to the agent
  lastAssignedAt DateTime? // AM assignment tie-break
  // Staff imported from the MDM platform (Users on MDM): their user id there, what MDM says they
  // are, and their MDM usernames (sign-in checks the password with MDM, mdm-auth.js).
  mdmRef         String?   @unique
  mdmRole        String?
  mdmScope       String?
  mdmUsernames   String    @default("[]") // JSON array
  mdmManagerRef  String? // the account-manager record on MDM with the same email (sellers point at it)
  phones         String    @default("[]") // JSON array, as MDM lists them
  mdmSyncedAt    DateTime?
  removedAt      DateTime? // removed by an Admin: hidden from every list and pick, kept for the audit history
  createdAt      DateTime  @default(now())

  contactsOwned   Contact[]       @relation("ContactOwner")
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  sellersManaged  Seller[]        @relation("SellerAM")
  notifications   Notification[]
  messages        Message[]
  elevations      RoleElevation[] @relation("ElevatedUser")
}

// Temporary elevation (OA 9.3): cover for leave is time-bound. While active, the user acts as
// `role`; it expires automatically at endsAt and the reversion is audited.
model RoleElevation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("ElevatedUser", fields: [userId], references: [id])
  role        String
  reason      String
  grantedById String?
  startsAt    DateTime  @default(now())
  endsAt      DateTime
  revokedAt   DateTime? // set early by an Admin, or by the expiry sweep at endsAt
  createdAt   DateTime  @default(now())

  @@index([userId, endsAt])
}

// ───────────────────────── Platform core ─────────────────────────
// contactType: merchant (pre-activation) | seller (activated) | end_customer | internal
model Contact {
  id                String    @id @default(cuid())
  name              String
  nameAr            String?
  phone             String    @unique // E.164
  country           String // LY | IQ | LB ...
  contactType       String    @default("merchant")
  ownerAgentId      String?
  ownerAgent        User?     @relation("ContactOwner", fields: [ownerAgentId], references: [id])
  optedOut          Boolean   @default(false)
  blocked           Boolean   @default(false)
  blockReason       String?
  sourceUtm         String? // channel + UTM / affiliate tag, immutable after creation
  legacy            Boolean   @default(false) // imported from Zoho
  mdmRef            String? // the merchant's seller id on the MDM platform (trackingId), once known
  mdmResponsibleRef String? // the MDM user responsible for the join (Seller.joinStatusResponsible); the lead's owner once imported
  mdmCreatedAt      DateTime? // when the merchant entered the MDM platform (Seller.createdAt) — the date filters use it
  createdAt         DateTime  @default(now())

  conversations Conversation[]
  tickets       Ticket[]
  seller        Seller?

  @@index([mdmRef])
  @@index([mdmResponsibleRef])
}

model Conversation {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id])
  channel        String    @default("whatsapp") // whatsapp | voice | portal | email
  businessNumber String? // the company number the thread runs on
  lastInboundAt  DateTime? // drives the 24h session window
  lastOutboundAt DateTime?
  // Admin take-over of a conversation with no open onboarding ticket (AM monitoring). While set,
  // only this user may reply; released explicitly. Onboarding take-over reassigns the ticket instead.
  takenOverById  String?
  takenOverAt    DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([contactId]) // one conversation per contact, for life
}

// direction: in | out | internal ; kind: text | template | call_event | note | system
// internal = notes and system lines, never shown to the contact
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String
  kind           String       @default("text")
  body           String
  templateKey    String?
  billable       Boolean      @default(false)
  authorUserId   String?
  author         User?        @relation(fields: [authorUserId], references: [id])
  legacy         Boolean      @default(false)
  externalId     String?      @unique // provider message id (WhatsApp wamid, Yeastar call id) — dedupes webhooks
  deliveryStatus String? // queued | sent | delivered | read | failed | not_sent (no transport configured)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ───────────────────────── Tickets (both modules) ─────────────────────────
// type: onboarding_task | am_task
// OA statuses: new | failed_to_contact | prequalified | qualified | activated | cold_lead | junk_lead
// AM task status: open | done
// OA stage: first_contact | walkthrough | documents | activation | done
model Ticket {
  id         String    @id @default(cuid())
  type       String
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id])
  assigneeId String?
  assignee   User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  status     String
  priority   String    @default("normal") // urgent | high | normal | low
  dueAt      DateTime?
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  // ── onboarding_task fields (spec OA 2.3) ──
  stage           String?
  attemptNo       Int       @default(0)
  nextAttemptAt   DateTime?
  followupNo      Int       @default(0)
  nextFollowupAt  DateTime?
  cadenceReset    Boolean   @default(false)
  holdReason      String? // never null while unassigned
  heldAt          DateTime? // when it entered the holding queue (r8 escalation clock)
  stalledReason   String? // written reason required once open past stalled_day (OA 5.5)
  tags            String    @default("[]") // JSON array, e.g. oa_cold_no_answer
  walkthroughAt   DateTime?
  walkthroughMode String? // phone | meet | whatsapp_video
  qualification   String    @default("{}") // JSON: 5 booleans (OA 8.1)
  handoffRecord   String    @default("{}") // JSON: 8 fields (OA 2.6)
  firstOrderAt    DateTime? // written by order-domain event only

  // ── am_task fields (spec AM 2.2) ──
  sellerId         String?
  seller           Seller?   @relation(fields: [sellerId], references: [id])
  taskType         String? // welcome | checkin | intervention | save | qbr | coach | expansion | coord
  title            String?
  why              String? // required on am_task — the numbers that produced it
  ruleId           String? // dedup key (AM 2.5)
  alertKey         String?
  escalated        Boolean   @default(false)
  escalatedAt      DateTime?
  escalationReason String?
  outcome          String? // required to close an am_task

  @@index([type, status, assigneeId])
  @@index([contactId])
  @@index([sellerId, status])
  @@index([dueAt])
}

// ───────────────────────── Seller record (AM module) ─────────────────────────
// joinStatus: pending | accepted | rejected ; stage + health are DERIVED, cached here (never user-writable)
model Seller {
  id                       String    @id @default(cuid())
  mdmRef                   String    @unique // e.g. MDM-S-0207 (id on the client's MDM platform)
  contactId                String    @unique
  contact                  Contact   @relation(fields: [contactId], references: [id])
  market                   String
  joinStatus               String    @default("pending")
  activatedAt              DateTime?
  assignedAccountManagerId String?
  accountManager           User?     @relation("SellerAM", fields: [assignedAccountManagerId], references: [id])
  mdmManagerRef            String? // the account manager MDM names for the seller (Seller.accountManager.trackingId)

  // read-only mirror of the MDM platform (synced via API connector or import)
  weeklyOrders       String    @default("[]") // JSON array of 8 ints, weeks 1..8 (oldest first)
  deliveryRate       Float     @default(0)
  returnRate         Float     @default(0)
  cancelRate         Float     @default(0)
  wallet             Float     @default(0)
  walletNegativeDays Int       @default(0)
  products           Int       @default(0)
  marketsServed      Int       @default(1)
  momGrowthPct       Float     @default(0)
  lastOrderAt        DateTime?
  totalOrders        Int       @default(0) // lifetime orders (playbook gates)
  weeklyReturnRates  String    @default("[]") // JSON, weeks 1..8 oldest first (r6 "sustained")
  mirrorInputs       String    @default("{}") // JSON: the platform counts behind the rates (window, delivered, returned, cancelled, orders) — AM 4.6
  // Feature F5 (not yet written by MDM platform — Engagement fallback applies)
  lastLoginAt        DateTime?
  lastStoreUpdateAt  DateTime?
  lastProductAddedAt DateTime?

  lastContactAt DateTime?
  lastSyncedAt  DateTime? // last mirror update from the MDM platform connector or an import
  lastReviewAt  DateTime?
  churnedAt     DateTime? // set by hand until D-04 structured outcome exists
  welcomeCallAt DateTime?

  // cached derived values (recompute job output; inputs stored for explainability)
  stage            String    @default("New")
  healthScore      Int?
  healthBand       String?
  healthComponents String    @default("{}") // JSON: per-component score/weight/sentence/inputs
  healthComputedAt DateTime?
  healthStale      Boolean   @default(false)

  tasks            Ticket[]
  healthHistory    HealthHistory[]
  playbookProgress PlaybookProgress[]

  @@index([assignedAccountManagerId])
  @@index([market, joinStatus])
}

model HealthHistory {
  id         String   @id @default(cuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  date       DateTime
  score      Int
  band       String
  components String // JSON snapshot

  @@index([sellerId, date])
}

// 30-day playbook (AM 6.1): step state; gates evaluated live, never stored as truth
model PlaybookProgress {
  id           String    @id @default(cuid())
  sellerId     String
  seller       Seller    @relation(fields: [sellerId], references: [id])
  stepDay      Int // 0,1,3,5,7,14,21,30
  taskTicketId String?
  tickedAt     DateTime?
  tickedById   String?

  @@unique([sellerId, stepDay])
}

// ───────────────────────── Configuration (versioned, snapshot not diff) ─────────────────────────
model ConfigVersion {
  id        Int      @id @default(autoincrement())
  authorId  String?
  note      String?
  diff      String // JSON: {key: {before, after}}
  snapshot  String // JSON: FULL configuration (rollback restores this exactly)
  createdAt DateTime @default(now())
}

model ConfigDraft {
  id        String   @id @default("draft") // single-row table
  changes   String   @default("{}") // JSON pending {key: value}
  authorId  String?
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Templates & macros ─────────────────────────
// Meta WhatsApp templates. status: pending | approved | rejected
model Template {
  id       String  @id @default(cuid())
  key      String  @unique
  module   String // oa | am
  category String  @default("utility") // marketing prohibited on the onboarding number
  bodyEn   String
  bodyAr   String?
  status   String  @default("pending")
  enabled  Boolean @default(true)
}

model Macro {
  id         String  @id @default(cuid())
  module     String // oa | am
  scope      String  @default("team") // team | personal
  ownerId    String?
  name       String
  actions    String  @default("{}") // JSON ticket changes
  insertText String  @default("")
  usageCount Int     @default(0)
}

model SavedView {
  id      String  @id @default(cuid())
  module  String
  scope   String  @default("system") // system | team | personal
  ownerId String?
  name    String
  filters String  @default("{}")
  sort    String?
}

// ───────────────────────── Immutable event log (single audit trail) ─────────────────────────
model EventLog {
  id         String   @id @default(cuid())
  actorId    String? // null = system/rule
  entityType String // ticket | contact | seller | config | conversation | user
  entityId   String
  action     String
  before     String? // JSON
  after      String? // JSON
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// In-app notifications (rules' notify(...) action). dedupeKey makes every rule notification
// idempotent: a sweep run twice notifies once.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // e.g. oa.r3.attempt_due
  title     String
  body      String?
  ticketId  String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
}

// One run of an integration (MDM sync, Zoho import, …): what it did, with per-row results.
model IntegrationRun {
  id         String    @id @default(cuid())
  kind       String // mdm_sync | zoho_import
  status     String // dry_run | completed | failed
  actorId    String?
  summary    String    @default("{}") // JSON counts + per-row results
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// A seller the MDM pull could not place (market outside Libya, Iraq and Lebanon, no phone,
// rejected on the platform, stale registration, already here): kept aside with what the platform
// says about it until an Admin decides where it goes (Integrations page → Skipped sellers).
// One row per platform seller; the decision and its outcome stay on the row, the immutable
// record of who decided is the EventLog entry (mdm.skipped_decided).
model MdmSkipped {
  id                String    @id @default(cuid())
  mdmRef            String    @unique
  reasonCode        String // market | phone | rejected | duplicate | stale | other
  reason            String
  name              String?
  phone             String?
  country           String? // the market the sync derived (2-letter), possibly outside LY/IQ/LB
  countries         String    @default("[]") // JSON: every country code the platform lists for the seller
  countryId         String?
  joinStatus        String?
  joinStatusDate    DateTime?
  registeredAt      DateTime?
  accountManagerRef String?
  responsibleRef    String? // the MDM user responsible for the join (Seller.joinStatusResponsible)
  utm               String?
  platform          String    @default("{}") // JSON: the platform record as last read
  seenCount         Int       @default(1)
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  runId             String?
  decision          String? // null = waiting | placed | lead | left_out | imported
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  outcome           String    @default("{}") // JSON: what the decision produced (seller, contact, ticket, ownership)
  figuresAt         DateTime? // placed sellers: when their platform figures were first read

  @@index([decision, reasonCode])
}

// Every user the MDM platform lists (Users on MDM), kept aside for the Admin's decision: imported
// as one of ours (with the role the Admin names), or left out. One row per platform user; the
// immutable record of who decided is the EventLog entry (mdm.staff_decided). `userId` links the
// row to the account here once imported; every later sync refreshes name, markets and restriction.
model MdmStaff {
  id           String    @id @default(cuid())
  mdmRef       String    @unique // the user's trackingId on MDM
  name         String
  email        String?
  phones       String    @default("[]") // JSON
  usernames    String    @default("[]") // JSON: MDM sign-in names
  role         String? // as MDM names it
  scope        String? // as MDM names it (the owner's "Commercial" group is a scope)
  countries    String    @default("[]") // JSON: as MDM lists them (ids or codes)
  markets      String    @default("[]") // JSON: LY | IQ | LB, derived from `countries`
  restricted   Boolean   @default(false)
  managerRef   String? // the account-manager record on MDM with the same email, if any
  lastLoginAt  DateTime?
  mdmCreatedAt DateTime?
  platform     String    @default("{}") // JSON: the platform record as last read
  seenCount    Int       @default(1)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  runId        String?
  userId       String? // our account, once imported (or linked by email)
  decision     String? // null = waiting | imported | left_out
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  outcome      String    @default("{}") // JSON

  @@index([decision, scope])
}

// Everything MDM returns for a merchant or a person, kept exactly as MDM sent it (MDM Swagger):
// the seller record (seller), each of its stores (store), the seller's own team members
// (team_member), what MDM charges the seller per market (service_fees: plan, call-centre,
// fulfilment and shipping pricing — finance only), and each MDM user (user). Read-only here: the
// sync replaces a record whenever MDM's copy changes. Shown on the "From MDM" card.
model MdmRecord {
  id        String   @id @default(cuid())
  kind      String // seller | store | team_member | service_fees | user
  mdmRef    String // the record's id on MDM (service_fees: "<sellerRef>:<countryId>")
  sellerRef String? // stores, team members and fees: the seller they belong to
  data      String   @default("{}") // JSON, as MDM returned it
  fetchedAt DateTime @default(now())

  @@unique([kind, mdmRef])
  @@index([sellerRef])
}

// Countries as MDM names them (id, alpha-3 code, name), learnt from every seller the sync reads;
// lets a platform user's country ids become markets here.
model MdmCountry {
  id        String   @id
  code      String
  name      String?
  updatedAt DateTime @updatedAt
}

// A merchant (lead, seller or a seller kept aside) an Admin deleted from this app. MDM is never
// touched (its API offers no delete for sellers). While keepOut is true the sync does not bring the
// merchant back (matched by MDM id or phone); restoring clears it so the next sync imports it again.
// The record keeps what was deleted, for the audit history, and the template sends it carried, so a
// delete never gives back template budget already spent.
model DeletedMerchant {
  id            String    @id @default(cuid())
  kind          String // lead | seller | skipped
  name          String?
  phone         String?
  mdmRef        String?
  contactId     String? // the deleted contact's id (gone), for the audit trail
  snapshot      String    @default("{}") // JSON: what was deleted (tickets, seller, owner, counts)
  templateSends String    @default("[]") // JSON [{ at, key }]: billable template sends that were deleted
  keepOut       Boolean   @default(true)
  reason        String
  batchId       String
  deletedById   String?
  deletedAt     DateTime  @default(now())
  restoredAt    DateTime?
  restoredById  String?

  @@index([mdmRef])
  @@index([phone])
  @@index([deletedAt])
}
