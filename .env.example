DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"

# ── Integrations (unset = the app runs on imported/seeded data) ──
# MDM e-commerce platform — the only connector switched on for now (docs/mdm-integration.md)
MDM_API_KEY=""                 # x-api-key for https://api.mdm.express; turns the pull sync on
MDM_API_URL=""                 # default https://api.mdm.express
MDM_WEBHOOK_SECRET=""          # sent by the platform as X-MDM-Key on POST /api/integrations/mdm/events
MDM_WRITEBACK=""               # "on" = record our call outcomes and AM assignments on MDM
MDM_PAYMENT_PASSWORD=""        # x-payment-password, only needed to read seller wallets
MDM_LEAD_MAX_AGE_DAYS="60"     # pending MDM registrations older than this are not opened as leads
MDM_SYNC_MINUTES="15"
MDM_PUSH_SECONDS="60"
# Kept for later, off unless listed here: whatsapp, yeastar, zoho (e.g. "whatsapp,zoho")
OPTIONAL_INTEGRATIONS=""
# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""         # verifies X-Hub-Signature-256 on the webhook
WHATSAPP_VERIFY_TOKEN=""       # the token entered in Meta's webhook settings
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANGUAGE="ar"
ONBOARDING_NUMBER=""
# Yeastar PBX
YEASTAR_WEBHOOK_SECRET=""      # X-Yeastar-Secret on POST /api/integrations/yeastar/events
YEASTAR_API_URL=""
YEASTAR_ACCESS_TOKEN=""
