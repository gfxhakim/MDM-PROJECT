DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"

# ── Integrations (all optional; unset = the app runs on imported/seeded data) ──
# MDM e-commerce platform connector
MDM_API_URL=""
MDM_API_KEY=""
MDM_WEBHOOK_SECRET=""          # sent by the platform as X-MDM-Key on POST /api/integrations/mdm/events
MDM_SYNC_MINUTES="60"
# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""         # verifies X-Hub-Signature-256 on the webhook
WHATSAPP_VERIFY_TOKEN=""       # the token entered in Meta's webhook settings
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANGUAGE="ar"
ONBOARDING_NUMBER=""
# Yeastar PBX
YEASTAR_WEBHOOK_SECRET=""      # X-Yeastar-Secret on POST /api/integrations/yeastar/events
YEASTAR_API_URL=""
YEASTAR_ACCESS_TOKEN=""
